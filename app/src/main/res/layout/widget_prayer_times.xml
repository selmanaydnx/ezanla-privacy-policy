<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic Theme & Motif Canvas Background -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Widget Arka Planı"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <!-- Main Content Layer -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_icon_mosque"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Cami"
                android:src="@drawable/ic_mosque" />

            <TextView
                android:id="@+id/widget_city_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="İstanbul"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_date_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="12 Eylül • 1 Rebiülahir"
                android:textColor="#8EA39A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_motif_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="✦ Selçuklu"
                android:textColor="#00D285"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_button_refresh"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Yenile"
                android:padding="2dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- Center Cards: Current Prayer & Next Prayer Countdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Left: Current Prayer -->
            <FrameLayout
                android:id="@+id/widget_current_container_frame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_current_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Şu Anki Vakit Kartı"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_badge_current" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/widget_current_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ŞU ANKİ VAKİT"
                        android:textColor="#00D285"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_current_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="ÖĞLE"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_current_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="13:12"
                        android:textColor="#B0D5C7"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Right: Next Prayer & Countdown -->
            <FrameLayout
                android:id="@+id/widget_next_container_frame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_next_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Sıradaki Vakit Kartı"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_badge_next" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/widget_next_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIRADAKİ VAKİT"
                        android:textColor="#FFB300"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_next_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="İKİNDİ (16:48)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_countdown_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01:45:20 kaldı"
                        android:textColor="#FFE082"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom Mini Prayer Times Bar -->
        <FrameLayout
            android:id="@+id/widget_times_bar_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/widget_times_bar_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Vakit Barı"
                android:scaleType="fitXY" />

            <LinearLayout
                android:id="@+id/widget_times_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/widget_time_imsak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="İms\n05:12"
                    android:textColor="#A0B2A8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_gunes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Güneş\n06:40"
                    android:textColor="#A0B2A8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_ogle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Öğle\n13:12"
                    android:textColor="#A0B2A8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_ikindi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="İkindi\n16:48"
                    android:textColor="#A0B2A8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_aksam"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Akşam\n19:35"
                    android:textColor="#A0B2A8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_yatsi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Yatsı\n20:56"
                    android:textColor="#A0B2A8"
                    android:textSize="9sp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
